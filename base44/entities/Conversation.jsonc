{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Conversation title shown in sidebar"
    },
    "workspace_id": {
      "type": "string",
      "description": "Reference to the workspace this conversation belongs to"
    },
    "summary": {
      "type": "string",
      "description": "Auto-generated conversation summary for context"
    },
    "is_archived": {
      "type": "boolean",
      "description": "Whether the conversation is archived",
      "default": false
    },
    "last_message_preview": {
      "type": "string",
      "description": "Preview text of the last message for sidebar display"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User ids who can see this conversation (copied from the workspace at creation). RLS enforces member visibility.",
      "default": []
    }
  },
  "required": [
    "title",
    "workspace_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "ChangeEvent",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this transition belongs to"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Workspace members at emission time; RLS enforces member reads."
    },
    "run_id": {
      "type": "string",
      "description": "The BeliefSnapshot id that produced this transition. Groups events from one derivation run and gives temporal lineage via the snapshot chain (Phase 14 Principle 6)."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "evidence_added",
        "evidence_removed",
        "evidence_reweighted",
        "belief_emerged",
        "belief_revised",
        "belief_collapsed",
        "identity_established",
        "identity_revised",
        "relationship_formed",
        "relationship_broken"
      ],
      "description": "The kind of state transition recorded. Change is the primary object; the ledger never stores conclusions, only transitions."
    },
    "subject_type": {
      "type": "string",
      "enum": [
        "memory",
        "belief",
        "identity",
        "relationship"
      ],
      "description": "What kind of subject changed."
    },
    "subject_id": {
      "type": "string",
      "description": "Stable id of the subject: memory id, normalized belief key, 'identity', or 'source|type|target' for relationships."
    },
    "subject_label": {
      "type": "string",
      "description": "Human-readable label: the belief claim, a memory content preview, 'Identity', or a relationship phrase."
    },
    "from_state": {
      "type": "object",
      "description": "Prior state snapshot. Null on emergence.",
      "properties": {}
    },
    "to_state": {
      "type": "object",
      "description": "New state snapshot. Null on collapse.",
      "properties": {}
    },
    "delta": {
      "type": "number",
      "description": "Numeric change where meaningful: confidence delta for beliefs, +/-1 for evidence add/remove, importance delta for reweight, weight for relationships.",
      "default": 0
    },
    "cause": {
      "type": "string",
      "description": "Human-readable summary of why this transition was recorded."
    },
    "cause_metadata": {
      "type": "object",
      "description": "Structured 'why': for belief revisions this decomposes the change into base-evidence drift and deterministic propagation drivers (related beliefs, relationship type, weight, contribution). Lets COGNOS answer 'why did this belief change?' from the ledger alone.",
      "properties": {}
    }
  },
  "required": [
    "workspace_id",
    "event_type",
    "subject_type",
    "subject_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "Workspace",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the workspace"
    },
    "description": {
      "type": "string",
      "description": "Optional description of the workspace purpose"
    },
    "instructions": {
      "type": "string",
      "description": "Workspace-level system instructions that shape AI behavior"
    },
    "color": {
      "type": "string",
      "description": "Accent color hex code for visual identification",
      "default": "#3B82F6"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name for the workspace",
      "default": "Brain"
    },
    "is_default": {
      "type": "boolean",
      "description": "Whether this is the user's default workspace",
      "default": false
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User ids who are members of this workspace (includes the owner). The source of truth for membership; new conversations, messages, and shared memories copy this list at creation so RLS can enforce member access without a cross-record join.",
      "default": []
    },
    "member_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display-only mirror of member_ids (emails). Denormalized at invite time so a non-admin owner can show membership without an admin-only User lookup.",
      "default": []
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
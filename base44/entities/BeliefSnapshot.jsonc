{
  "name": "BeliefSnapshot",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this derivation snapshot belongs to."
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Workspace members at derivation time; RLS enforces member reads."
    },
    "prior_snapshot_id": {
      "type": "string",
      "description": "The previous BeliefSnapshot id. The lineage chain makes history replayable \u2014 every change is reversible and reconstructable (Phase 14 Principle 6)."
    },
    "identity": {
      "type": "string",
      "description": "Synthesized identity statement at this derivation."
    },
    "beliefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Stable normalized-claim key used to match a belief across derivation runs."
          },
          "claim": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "base": {
            "type": "number",
            "description": "Confidence as emitted by the LLM, before deterministic propagation."
          },
          "confidence": {
            "type": "number",
            "description": "Live (propagated) confidence after the deterministic relationship pass \u2014 the value the UI shows and the ledger diffs."
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          },
          "contradicting_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          },
          "rationale": {
            "type": "string"
          },
          "last_challenged": {
            "type": "string"
          },
          "drivers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "subject_id": {
                  "type": "string"
                },
                "subject_label": {
                  "type": "string"
                },
                "relationship": {
                  "type": "string",
                  "description": "supports | contradicts | depends_on"
                },
                "weight": {
                  "type": "number"
                },
                "related_confidence": {
                  "type": "number"
                },
                "contribution": {
                  "type": "number",
                  "description": "Signed delta this driver applied to the belief's confidence."
                },
                "via": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "The deterministic propagation drivers that moved this belief's confidence away from its base. The structured 'why' for a revision."
          }
        }
      },
      "description": "The full derived belief set at this point in time, enriched with the deterministic propagation result. History, not asserted truth \u2014 current beliefs are always re-derived on demand (Phase 13). The snapshot exists so Phase 14 can diff across time."
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "Belief key the edge leaves from (the one being influenced)."
          },
          "target": {
            "type": "string",
            "description": "Belief key the edge points to (the influencer)."
          },
          "source_label": {
            "type": "string"
          },
          "target_label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "supports",
              "contradicts",
              "depends_on"
            ]
          },
          "weight": {
            "type": "number"
          },
          "via": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Evidence ids that establish this relationship."
          }
        }
      },
      "description": "The deterministic belief\u2194belief relationship graph inferred from shared/conflicting evidence at this derivation. Tiny ontology v1: supports, contradicts, depends_on. Stored so the relationship dynamics are replayable alongside the beliefs."
    },
    "evidence_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "importance": {
            "type": "integer"
          },
          "evidence_level": {
            "type": "string"
          },
          "content_preview": {
            "type": "string"
          }
        }
      },
      "description": "The enabled-memory evidence base this snapshot was derived from. Used to detect evidence transitions (added/removed/reweighted) on the next run."
    },
    "evidence_count": {
      "type": "integer",
      "default": 0
    },
    "derived_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "workspace_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
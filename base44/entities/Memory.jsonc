{
  "name": "Memory",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Reference to the workspace this memory belongs to. A memory lives in one workspace; sharing it into a shared workspace moves it here (consent), revoking returns it to the owner's personal workspace."
    },
    "content": {
      "type": "string",
      "description": "The memory content \u2014 a fact, preference, or important detail"
    },
    "memory_type": {
      "type": "string",
      "enum": [
        "working",
        "episodic",
        "semantic"
      ],
      "description": "Level of memory: working (temporary), episodic (events), semantic (stable knowledge)",
      "default": "episodic"
    },
    "source": {
      "type": "string",
      "description": "Origin of the memory \u2014 conversation ID or manual entry"
    },
    "importance": {
      "type": "integer",
      "description": "Importance score 1-10",
      "default": 5,
      "minimum": 1,
      "maximum": 10
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "direct",
        "repeated",
        "inferred",
        "assumed"
      ],
      "description": "How this memory was established: direct (user stated it explicitly), repeated (stated across multiple exchanges), inferred (deduced from context), assumed (guessed without a clear basis). Makes memory auditable rather than a quiet accumulation of assumptions.",
      "default": "direct"
    },
    "last_confirmed": {
      "type": "string",
      "format": "date-time",
      "description": "When this memory was last validated or confirmed against the user. Updated on extraction, manual edit, and consolidation."
    },
    "volatility": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "How likely this memory is to become stale: low (name, identity, stable facts), medium (job, role, preferences), high (current project phase, living situation, in-progress state).",
      "default": "medium"
    },
    "is_enabled": {
      "type": "boolean",
      "description": "Whether this memory is active and used in context",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for categorizing and searching memories"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User ids who can see this memory. Personal memory: [owner]. Shared memory: the shared workspace's members. RLS enforces read; only the memory owner (created_by_id) may update/delete \u2014 so sharing (consent) is the owner's explicit, reversible act.",
      "default": []
    }
  },
  "required": [
    "workspace_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "Daily Council Briefing",
  "description": "Autonomous council deliberation (Phase 11): generates a proactive daily briefing insight for every workspace at 9am ET.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_council_briefing",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "briefing": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runCouncilAutonomous"
          },
          "then": "end",
          "x-base44": {
            "title": "Generate daily briefings",
            "description": "Autonomous council deliberation per workspace"
          }
        }
      }
    ]
  }
}
# Example environment variables for Cognos external runtime
# Copy this file to `.env` or configure equivalent environment variables in your host (Vercel, Fly, AWS, etc.).

# Required: your BluesMinds API key (keep secret)
BLUESMINDS_API_KEY=your_bluesminds_api_key_here

# Required: default model to use (example)
BLUESMINDS_MODEL=gpt_5_4

# Optional: override the BluesMinds HTTP endpoint
BLUESMINDS_API_URL=https://api.bluesminds.com/v1/chat/completions

# Required: shared secret used to authenticate runtime requests from Base44 or trusted clients
COGNOS_RUNTIME_SECRET=generate_a_secure_random_string

# Optional: port override
PORT=3000
